      "key": "clickTimeout",
      "type": "int",
      "default": 300,
      "min": 100,
      "max": 500,
      "label": "Click timeout (ms)",
      "description": "Timeout to distinguish double/triple clicks (ms)"
    },
    {
      "key": "doubleClickHoldThreshold",
      "type": "int",
      "default": 150,
      "min": 50,
      "max": 500,
      "label": "Double-click hold threshold (ms)",
      "description": "Max hold time for double-click actions (ms). Holding longer allows text selection"
    },
    {
      "key": "deferDoubleClickForTriple",
      "type": "bool",
      "default": false,
      "label": "Defer double-click for triple",
      "description": "Delay double-click to allow triple-click actions (disables triple-click when off)"
    },
    {
      "key": "selectionHoldTimeout",
      "type": "int",
      "default": 300,
      "min": 100,
      "max": 1000,
      "label": "Selection hold timeout (ms)",
      "description": "Timeout to allow text selection (ms)"
    },
    {
      "key": "quoteWithReply",
      "type": "bool",
      "default": true,
      "label": "Quote with reply",
      "description": "When quoting, also reply to the message"
    },
    {
      "key": "useSelectionForQuote",
      "type": "bool",
      "default": false,
      "label": "Use selection for quote",
      "description": "When quoting, use selected text if available"
    }
  ],
  "enabledByDefault": false,
  "target": "",
  "dependencies": [],
  "commands": [],
  "gaps": [
    "Open Thread: Qord cannot start a thread from a message yet.",
    "Toasts: upstream confirms copies (\"Link copied!\") and missing permissions with a toast; Qord has no toast yet, so these happen silently.",
    "The emoji setting is a text field instead of upstream's emoji picker.",
    "Delete on a message MessageLogger kept after deletion: upstream removes it from the chat; Qord leaves it.",
    "Disable in system DMs: Qord does not recognise DMs with Discord's system account yet."
  ],
  "notes": "Clicks are counted in the chat like the browser's click detail (single, double, triple); held Shift/Ctrl/Alt and Backspace/Delete count as modifiers. Which message types can be replied to follows the types Discord documents (MessageTypeSets.REPLYABLE only exists at runtime in Discord's client)."
}
